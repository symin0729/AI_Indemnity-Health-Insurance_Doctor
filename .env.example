# Server-only values. Never rename secrets with a VITE_ prefix.
CHAT_PROVIDER_MODE=direct
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
RAGFLOW_BASE_URL=
RAGFLOW_API_KEY=
RAGFLOW_DATASET_ID=
# 챗봇(IN 질문)이 검색할 정책자료 데이터셋(금융위·협회 자료). 비우면 RAGFLOW_DATASET_ID 를 쓴다.
# RAGFLOW_DATASET_ID 는 계산 설명용 약관 데이터셋(/api/evidence)에 쓴다.
RAGFLOW_GENERAL_DATASET_ID=
# on 일 때만 챗봇 검색에 상품 필터(productCode 등)를 적용한다. 정책자료 데이터셋에는 비워 둔다(기본 꺼짐).
CHATBOT_PRODUCT_FILTER=
# on 일 때만 검색어 뒤에 보강 문구(보상금액 공제금액 보상한도)를 붙인다(기본 꺼짐. 3세대 약관에서 해로웠음).
RAGFLOW_QUERY_RULES=
# RAG 근거로 쓸 수 있는 문서 상태(쉼표 구분). 비우면 VERIFIED 만 쓴다.
# 평가 통과 전 시험용 예: VERIFIED,AI_CROSS_CHECKED,AI_SOURCE_VALIDATED (승인 정책을 정한 뒤에만 넓힌다)
RAG_ALLOWED_STATUS=
# 검증된 근거 맵(knowledge/rule-evidence-map.json)에서 쓸 수 있는 상태. 비우면 VERIFIED 만 사용한다.
# 팀이 승인 정책을 정한 경우에만 넓힌다(예: VERIFIED,AI_SOURCE_VALIDATED).
EVIDENCE_MAP_ALLOWED_STATUS=
# 검색 튜닝 (15번 문서 평가에서 정한 값과 같아야 한다). 비우면 기본 동작: 벡터 0.3, 접두어 없음
RAGFLOW_VECTOR_WEIGHT=
RAGFLOW_QUERY_PREFIX=
LLM_PROVIDER=gemini
# Gemini API key from Google AI Studio (server-only).
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
LLM_THINKING_LEVEL=minimal  # 오류 발생시 low, medium, high로 변경 가능
CHAT_TIMEOUT_MS=12000
CHAT_MAX_LENGTH=300
CHAT_CONSENT_POLICY_VERSION=ai-chat-1.0

# 챗봇(정책자료) 검색 전용 벡터 가중치(0~1). 기본 0.5 (RAGFLOW_VECTOR_WEIGHT 는 약관 근거 검색용)
# CHATBOT_VECTOR_WEIGHT=0.5
